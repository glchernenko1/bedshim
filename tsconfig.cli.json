{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".cli",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["scripts", "src/core"],
  "exclude": ["**/*.test.ts"]
}
